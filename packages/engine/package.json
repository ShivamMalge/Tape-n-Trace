{
  "name": "@tape-n-trace/engine",
  "version": "0.1.0",
  "description": "The Tape-n-Trace core: machines, simulation, conversions, and the trace protocol. Pure TypeScript.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
