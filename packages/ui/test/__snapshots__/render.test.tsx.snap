exports[`InputStrip > separates what has been read from what has not 1`] = `"<div role="group" aria-label="Input 0110, 2 of 4 symbols read" style="font-family:var(--tnt-mono);font-size:16px;margin:0;display:flex;gap:4px;flex-wrap:wrap"><span class="tnt-input-cell tnt-animated" data-position="0" data-role="consumed" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;border-radius:var(--tnt-radius);border:1px solid var(--tnt-border);transition:background 140ms ease, color 140ms ease, border-color 140ms ease;color:var(--tnt-consumed);background:var(--tnt-surface)">0</span><span class="tnt-input-cell tnt-animated" data-position="1" data-role="consumed" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;border-radius:var(--tnt-radius);border:1px solid var(--tnt-border);transition:background 140ms ease, color 140ms ease, border-color 140ms ease;color:var(--tnt-consumed);background:var(--tnt-surface)">1</span><span class="tnt-input-cell tnt-animated" data-position="2" data-role="lookahead" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;border-radius:var(--tnt-radius);border:1px solid var(--tnt-border);transition:background 140ms ease, color 140ms ease, border-color 140ms ease;color:var(--tnt-lookahead);background:var(--tnt-bg)">1</span><span class="tnt-input-cell tnt-animated" data-position="3" data-role="lookahead" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:28px;border-radius:var(--tnt-radius);border:1px solid var(--tnt-border);transition:background 140ms ease, color 140ms ease, border-color 140ms ease;color:var(--tnt-lookahead);background:var(--tnt-bg)">0</span></div>"`;

exports[`TransportBar > renders the full control set 1`] = `"<div class="tnt-transport" role="toolbar" aria-label="Trace transport"><div class="tnt-transport-buttons"><button type="button" aria-label="Previous step" title="Previous step" class="tnt-btn tnt-btn-icon"><span aria-hidden="true">◀</span></button><button type="button" aria-label="Play" class="tnt-btn tnt-btn-primary tnt-transport-play">Play</button><button type="button" aria-label="Next step" title="Next step" class="tnt-btn tnt-btn-icon"><span aria-hidden="true">▶</span></button></div><div class="tnt-transport-scrub-wrap"><input type="range" min="0" max="5" step="1" aria-label="Step" aria-valuetext="Step 3 of 6" class="tnt-transport-scrub" value="2"/><span aria-hidden="true" class="tnt-transport-count">Step 2 of 5</span></div><label class="tnt-transport-speed"><span class="tnt-transport-speed-label">Speed</span><input type="range" min="0.5" max="4" step="0.5" aria-label="Playback speed" aria-valuetext="1.0×" class="tnt-transport-speed-range" value="1"/><span aria-hidden="true" class="tnt-transport-speed-value">1.0×</span></label></div>"`;
